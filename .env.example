# Copie para .env e preencha. Nunca versione o .env.

# Token do @BotFather (só o bot precisa)
TELEGRAM_BOT_TOKEN=

# ID do grupo-caderno (supergrupo, começa com -100) e do seu usuário
ALLOWED_CHAT_ID=
ALLOWED_USER_ID=

# Banco PostgreSQL local (só 127.0.0.1/localhost). Não versione a senha.
DATABASE_URL=postgresql+psycopg://postgres:SENHA@127.0.0.1:5432/telegram
# Banco só dos testes: o nome PRECISA terminar em _test (é apagado e recriado pelos testes).
TEST_DATABASE_URL=postgresql+psycopg://postgres:SENHA@127.0.0.1:5432/telegram_test

# Pasta da mídia baixada (ignorada pelo Git)
MEDIA_DIR=data/media

# Porta do painel; o host é sempre 127.0.0.1
PAINEL_PORT=8000

# Prévia de links (título e miniatura). 1 = o painel acessa os sites dos links;
# 0 = nenhuma requisição além do Telegram sai da máquina.
PREVIAS_LINKS=1

# Backup diário do banco, feito pelo painel (006). Vazio = %LOCALAPPDATA%\notas-telegram\backups
# Precisa ficar FORA do repositório.
BACKUP_DIR=
BACKUP_MANTER=7

# Sincronização (009): API oficial do Telegram com a SUA conta, só leitura do grupo.
# Crie em https://my.telegram.org → API development tools. Depois, uma vez:
#   uv run --env-file .env python -m notas.sincronizacao login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
